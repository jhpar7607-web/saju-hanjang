# 사주한장 환경 변수 예시. 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# 값을 비워 두면 해당 기능은 '로컬 대체 방식'으로 동작한다.

# 사이트 주소 (공유 미리보기와 결제 후 돌아올 주소에 쓰인다)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI 풀이 (비워 두면 규칙 기반 풀이로 동작)
ANTHROPIC_API_KEY=
AI_MODEL_FREE=claude-haiku-5-5
AI_MODEL_PAID=claude-sonnet-5-5
# 하루에 허용할 AI 호출 수 (넘으면 규칙 기반 풀이로 전환)
AI_DAILY_LIMIT=3000

# 결제: 토스페이먼츠 (비워 두면 개발 환경에서만 모의 결제로 동작)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 저장소: Supabase (비워 두면 .data 폴더의 파일에 저장)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 가격 (원)
PRICE_REGULAR=3900
PRICE_PROMO=2900
PROMO_START=2026-12-14
PROMO_END=2027-01-03

# 사업자 정보 (안내 화면에 표시)
NEXT_PUBLIC_BIZ_NAME=
NEXT_PUBLIC_BIZ_OWNER=
NEXT_PUBLIC_BIZ_NUMBER=
NEXT_PUBLIC_BIZ_MAILORDER=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_CONTACT=
